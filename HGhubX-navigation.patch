--- a/src-tauri/src/api/platform.rs
+++ b/src-tauri/src/api/platform.rs
@@ -98,3 +98,23 @@ pub async fn cache_clear(
     crate::media::clear_caches();
     crate::cache::clear_web_cache(&webview).await
 }
+
+/* ──────── 触感（iOS 走 Taptic Engine，其余平台由前端回退 Web Vibration） ──────── */
+
+#[tauri::command]
+pub fn haptic(app: tauri::AppHandle, kind: String) -> Result<bool, String> {
+    #[cfg(target_os = "ios")]
+    {
+        let queued = app
+            .run_on_main_thread(move || {
+                crate::ios_haptic::play(&kind);
+            })
+            .is_ok();
+        return Ok(queued);
+    }
+    #[cfg(not(target_os = "ios"))]
+    {
+        let _ = (&app, kind);
+        Ok(false)
+    }
+}
diff --git a/src-tauri/src/ios_haptic.rs b/src-tauri/src/ios_haptic.rs
new file mode 100644
index 0000000..f298666
--- /dev/null
+++ b/src-tauri/src/ios_haptic.rs
@@ -0,0 +1,164 @@
+// iOS 触感反馈（Taptic Engine）。
+//
+// 为什么不用 Core Haptics：CHHapticEngine 在某些机型/状态下启动失败会**静默无声**，
+// 而 UIFeedbackGenerator 走系统统一通道，且用户关掉「系统触感」时系统会自动忽略，
+// 天然符合无障碍要求。这里的取舍是「稳定出声 > 波形自由」。
+//
+// 质感靠的是 style 选择，不是加大强度：
+//   rigid(4)   —— 高锐度、零拖尾，最像机械微动开关的"咔"
+//   soft(3)    —— 钝、闷，适合"收回/收起"这类下沉语义
+//   light(0)   —— 轻回弹
+//   medium(1)  —— 明确确认
+//   heavy(2)   —— 重落点，只给危险操作
+//
+// 延迟：generator 首次创建要连 Taptic Engine（约 20–40ms）。所以这里把 6 个 generator
+// 缓存成常驻对象，交互开始前由前端发一次 `prepare`，真正要震时直接 impact = 0 延迟。
+
+use objc2::rc::{autoreleasepool, Retained};
+use objc2::runtime::AnyObject;
+use objc2::{class, msg_send};
+use std::cell::RefCell;
+
+const IMPACT_LIGHT: i64 = 0;
+const IMPACT_MEDIUM: i64 = 1;
+const IMPACT_HEAVY: i64 = 2;
+const IMPACT_SOFT: i64 = 3;
+const IMPACT_RIGID: i64 = 4;
+
+const SLOT_LIGHT: usize = 0;
+const SLOT_MEDIUM: usize = 1;
+const SLOT_HEAVY: usize = 2;
+const SLOT_SOFT: usize = 3;
+const SLOT_RIGID: usize = 4;
+const SLOT_SELECTION: usize = 5;
+const SLOT_NOTIFICATION: usize = 6;
+const SLOTS: usize = 7;
+
+thread_local! {
+    static GENERATORS: RefCell<[Option<Retained<AnyObject>>; SLOTS]> =
+        const { RefCell::new([None, None, None, None, None, None, None]) };
+}
+
+unsafe fn make_impact(style: i64) -> Option<Retained<AnyObject>> {
+    unsafe {
+        let cls = class!(UIImpactFeedbackGenerator);
+        let obj: *mut AnyObject = msg_send![cls, alloc];
+        if obj.is_null() {
+            return None;
+        }
+        let obj: *mut AnyObject = msg_send![obj, initWithStyle: style];
+        Retained::from_raw(obj)
+    }
+}
+
+unsafe fn make_selection() -> Option<Retained<AnyObject>> {
+    unsafe {
+        let cls = class!(UISelectionFeedbackGenerator);
+        let obj: *mut AnyObject = msg_send![cls, alloc];
+        if obj.is_null() {
+            return None;
+        }
+        let obj: *mut AnyObject = msg_send![obj, init];
+        Retained::from_raw(obj)
+    }
+}
+
+unsafe fn make_notification() -> Option<Retained<AnyObject>> {
+    unsafe {
+        let cls = class!(UINotificationFeedbackGenerator);
+        let obj: *mut AnyObject = msg_send![cls, alloc];
+        if obj.is_null() {
+            return None;
+        }
+        let obj: *mut AnyObject = msg_send![obj, init];
+        Retained::from_raw(obj)
+    }
+}
+
+fn slot_for(kind: &str) -> usize {
+    match kind {
+        "light" => SLOT_LIGHT,
+        "medium" => SLOT_MEDIUM,
+        "strong" | "heavy" => SLOT_HEAVY,
+        "snap" => SLOT_SOFT,
+        "select" | "selection" => SLOT_SELECTION,
+        "success" | "warning" | "error" => SLOT_NOTIFICATION,
+        // tick 是默认档：最清脆的那种微动开关声
+        _ => SLOT_RIGID,
+    }
+}
+
+/// 取（必要时创建）指定槽位的 generator。返回 true 表示句柄可用。
+fn with_generator<F: FnOnce(&AnyObject)>(slot: usize, f: F) -> bool {
+    GENERATORS.with(|cell| {
+        let mut slots = match cell.try_borrow_mut() {
+            Ok(v) => v,
+            Err(_) => return false,
+        };
+        if slots[slot].is_none() {
+            let made = unsafe {
+                match slot {
+                    SLOT_SELECTION => make_selection(),
+                    SLOT_NOTIFICATION => make_notification(),
+                    SLOT_SOFT => make_impact(IMPACT_SOFT),
+                    SLOT_RIGID => make_impact(IMPACT_RIGID),
+                    SLOT_LIGHT => make_impact(IMPACT_LIGHT),
+                    SLOT_MEDIUM => make_impact(IMPACT_MEDIUM),
+                    SLOT_HEAVY => make_impact(IMPACT_HEAVY),
+                    _ => make_impact(IMPACT_RIGID),
+                }
+            };
+            slots[slot] = made;
+        }
+        match slots[slot].as_ref() {
+            Some(obj) => {
+                f(&**obj);
+                true
+            }
+            None => false,
+        }
+    })
+}
+
+fn prepare_slot(slot: usize) -> bool {
+    with_generator(slot, |obj| unsafe {
+        let _: () = msg_send![obj, prepare];
+    })
+}
+
+fn fire(slot: usize) -> bool {
+    let ok = with_generator(slot, |obj| unsafe {
+        match slot {
+            SLOT_SELECTION => {
+                let _: () = msg_send![obj, selectionChanged];
+            }
+            SLOT_NOTIFICATION => {
+                // 0 = success，走系统自带的"预备 + 落点"组合波形
+                let _: () = msg_send![obj, notificationOccurred: 0i64];
+            }
+            _ => {
+                let _: () = msg_send![obj, impactOccurred];
+            }
+        }
+    });
+    if ok {
+        // 系统要求触发后重新 prepare，否则下一次会迟
+        let _ = prepare_slot(slot);
+    }
+    ok
+}
+
+/// 由 `api::platform::haptic` 在主线程调用。
+/// 返回 false 表示这台机器/这个状态下没发出震动（调用方据此回退 Web Vibration）。
+pub fn play(kind: &str) -> bool {
+    autoreleasepool(|_| {
+        if kind == "prepare" {
+            let mut any = false;
+            for slot in 0..SLOTS {
+                any |= prepare_slot(slot);
+            }
+            return any;
+        }
+        fire(slot_for(kind))
+    })
+}
