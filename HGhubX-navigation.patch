+import { invoke } from "@tauri-apps/api/core";
+import { isIos } from "../api/api";
+
+/**
+ * 触感反馈。
+ *
+ * 设计取舍（宁轻勿重、宁短勿长、只震关键节点）：
+ * - 微交互（点按、Tab、刻度）走 iOS 原生 `rigid` / `selection`，是高锐度瞬态，没有拖尾；
+ * - 状态切换（开关、播放/暂停）用 `medium` / `light` 区分方向，绝不使用长震动；
+ * - 结果类（成功/警告/错误）用系统 `notification` 的组合波形，自带"预备 + 落点"节奏；
+ * - iOS 的 WKWebView 没有 `navigator.vibrate`，所以旧代码在 iOS 上是静默空调用；
+ *   这里统一走原生命令，其他平台/失败才回退 Web Vibration。
+ *
+ * 延迟：首次触发会创建 Taptic Engine 的连接，约 20–40ms。所以交互开始（pointerdown、
+ * 页面重新可见）就调用 `hapticPrepare()` 预热，真正要震时才是 0 延迟。
+ */
+
+/** 与 `ios_haptic::play` 的字面量一一对应，不要单独改名。 */
+export type HapticKind =
+  | "tick"      // 最轻的清脆点击：普通按钮、Tab 落点
+  | "select"    // 选择感：分段控件、列表选中
+  | "light"     // 轻回弹：暂停
+  | "medium"    // 明确确认：开始播放、开关打开
+  | "strong"    // 重落点：删除、危险操作确认
+  | "snap"      // 吸附：拖动到刻度/边界后释放
+  | "success"
+  | "warning"
+  | "error";
+
+/** Web Vibration 回退时长（毫秒）；数值按手感调过，不要随意放大。 */
+const VIBRATE_MS: Record<HapticKind, number | number[]> = {
+  tick: 8,
+  select: 8,
+  light: 12,
+  medium: 20,
+  strong: 30,
+  snap: 10,
+  success: [10, 40, 12],
+  warning: 18,
+  error: [14, 46, 14],
+};
+
+/** 同类反馈的最小间隔：连点、拖动时合并成一下，避免变成"持续嗡嗡"。 */
+const MIN_GAP: Record<HapticKind, number> = {
+  tick: 30,
+  select: 30,
+  light: 40,
+  medium: 45,
+  strong: 60,
+  snap: 40,
+  success: 120,
+  warning: 120,
+  error: 120,
+};
+
+let lastAt = 0;
+let lastKind: HapticKind | null = null;
+/** 原生通道失败一次就长期降级，避免每次交互都白跑一次 IPC。 */
+let nativeBroken = false;
+/** 预热节流：1.2s 内不重复请求，避免拖动手势把 IPC 打满。 */
+let preparedAt = 0;
+
+function web(kind: HapticKind) {
+  try {
+    navigator.vibrate?.(VIBRATE_MS[kind]);
+  } catch {
+    /* 不支持的设备就当没这回事，震动绝不能影响交互本身 */
+  }
+}
+
+/** 原生通道当前是否可用（只读，便于诊断与测试）。 */
+export function hapticNativeReady(): boolean {
+  return isIos && !nativeBroken;
+}
+
+/**
+ * 预热 Taptic Engine。在 pointerdown / 页面可见时调用，能抹掉首次触发的几十毫秒延迟。
+ * 没有交互时不要定时调用——那是纯耗电。
+ */
+export function hapticPrepare(): void {
+  if (nativeBroken || !isIos) return;
+  const now = typeof performance !== "undefined" ? performance.now() : Date.now();
+  if (now - preparedAt < 1200) return;
+  preparedAt = now;
+  invoke("haptic", { kind: "prepare" }).catch(() => { nativeBroken = true; });
+}
+
+/**
+ * 触发一次触感。
+ * @param kind 档位，默认 `tick`
+ * @param gapMs 与同类上一次反馈的最小间隔；滑动类交互传更大的值进一步降频
+ */
+export function haptic(kind: HapticKind = "tick", gapMs?: number): void {
+  const now = typeof performance !== "undefined" ? performance.now() : Date.now();
+  const gap = gapMs ?? MIN_GAP[kind];
+  if (now - lastAt < gap && lastKind === kind) return;
+  lastAt = now;
+  lastKind = kind;
+  if (!hapticNativeReady()) {
+    web(kind);
+    return;
+  }
+  invoke<boolean>("haptic", { kind })
+    .then((native) => { if (!native) web(kind); })
+    .catch(() => { nativeBroken = true; web(kind); });
+}
+
+/** 开关：打开给 `medium`（更明确的确认），关闭给 `tick`（干脆的回收声）。 */
+export const hapticToggle = (on: boolean) => haptic(on ? "medium" : "tick");
+
+/** Tab / 分段控件真正换到另一项：一次干净的 `select`。 */
+export const hapticSelect = () => haptic("select");
+
+/** 滑块连续取值：间隔拉到 110ms，按下与松手各一次。 */
+export const hapticSlide = () => haptic("select", 110);
+
+/** 拖到边界/刻度后吸附住的那一下。 */
+export const hapticSnap = () => haptic("snap");
+
+/* 首次按下就预热：iOS 上第一次触感不再"慢半拍"。 */
+if (typeof window !== "undefined") {
+  const warm = () => { hapticPrepare(); };
+  window.addEventListener("pointerdown", warm, { capture: true, once: true, passive: true });
+  document.addEventListener("visibilitychange", () => {
+    if (document.visibilityState === "visible") hapticPrepare();
+  });
+}
