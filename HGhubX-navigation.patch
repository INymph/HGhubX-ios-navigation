@@ -0,0 +1,190 @@
+import { useEffect, useRef, type RefObject } from "react";
+import { haptic } from "../../lib/haptics";
+
+const EDGE_WIDTH = 28;
+const COMMIT_RATIO = 0.32;
+const FLICK_VELOCITY = 0.42; // px/ms
+const AXIS_RATIO = 1.35;
+
+type Options = {
+  enabled: boolean;
+  containerRef: RefObject<HTMLElement | null>;
+  topLayerRef: RefObject<HTMLDivElement | null>;
+  underLayerRef: RefObject<HTMLDivElement | null>;
+  onPeekChange: (peeking: boolean) => void;
+  onSwipeCommit: () => void;
+};
+
+/**
+ * iOS-style interactive left-edge swipe-back for stacked pages.
+ * Drives DOM transforms directly during touchmove to avoid per-frame React renders.
+ */
+export function useEdgeSwipeBack({
+  enabled,
+  containerRef,
+  topLayerRef,
+  underLayerRef,
+  onPeekChange,
+  onSwipeCommit,
+}: Options) {
+  const stateRef = useRef({
+    enabled,
+    onPeekChange,
+    onSwipeCommit,
+  });
+  stateRef.current = { enabled, onPeekChange, onSwipeCommit };
+
+  useEffect(() => {
+    const container = containerRef.current;
+    if (!container) return;
+
+    let active = false;
+    let dragging = false;
+    let startX = 0;
+    let startY = 0;
+    let lastX = 0;
+    let lastT = 0;
+    let vx = 0;
+    let width = 375;
+    let settleTimer = 0;
+
+    const clearStyles = (top: HTMLElement | null, under: HTMLElement | null) => {
+      if (top) {
+        top.style.transform = "";
+        top.style.transition = "";
+        top.style.boxShadow = "";
+        top.style.willChange = "";
+      }
+      if (under) {
+        under.style.transform = "";
+        under.style.transition = "";
+        under.style.opacity = "";
+        under.style.willChange = "";
+      }
+    };
+
+    const canStart = (target: EventTarget | null) => {
+      if (!stateRef.current.enabled) return false;
+      if (document.querySelector(".ios-overlay")) return false;
+      if (!(target instanceof Element)) return true;
+      if (target.closest("input, textarea, select, [role=dialog], [data-swipe-back-ignore]")) return false;
+      return true;
+    };
+
+    const onTouchStart = (e: TouchEvent) => {
+      window.clearTimeout(settleTimer);
+      if (e.touches.length !== 1 || !canStart(e.target)) {
+        active = false;
+        return;
+      }
+      const touch = e.touches[0];
+      if (touch.clientX > EDGE_WIDTH) {
+        active = false;
+        return;
+      }
+      active = true;
+      dragging = false;
+      startX = touch.clientX;
+      startY = touch.clientY;
+      lastX = touch.clientX;
+      lastT = performance.now();
+      vx = 0;
+      width = container.clientWidth || window.innerWidth || 375;
+    };
+
+    const onTouchMove = (e: TouchEvent) => {
+      if (!active || e.touches.length !== 1) return;
+      const touch = e.touches[0];
+      const dx = touch.clientX - startX;
+      const dy = touch.clientY - startY;
+
+      if (!dragging) {
+        if (Math.abs(dy) > 10 && Math.abs(dy) >= Math.abs(dx)) {
+          active = false;
+          return;
+        }
+        if (dx > 10 && dx > Math.abs(dy) * AXIS_RATIO) {
+          dragging = true;
+          stateRef.current.onPeekChange(true);
+          const top = topLayerRef.current;
+          const under = underLayerRef.current;
+          if (top) {
+            top.style.transition = "none";
+            top.style.willChange = "transform";
+            top.style.boxShadow = "-12px 0 32px rgba(0,0,0,.38)";
+          }
+          if (under) {
+            under.style.transition = "none";
+            under.style.willChange = "transform, opacity";
+          }
+        } else {
+          return;
+        }
+      }
+
+      e.preventDefault();
+      const now = performance.now();
+      const dt = Math.max(1, now - lastT);
+      vx = (touch.clientX - lastX) / dt;
+      lastX = touch.clientX;
+      lastT = now;
+
+      const clamped = Math.max(0, Math.min(width, dx));
+      const progress = clamped / width;
+      const top = topLayerRef.current;
+      const under = underLayerRef.current;
+      if (top) top.style.transform = `translate3d(${clamped}px, 0, 0)`;
+      if (under) {
+        under.style.transform = `translate3d(${(-22 * (1 - progress)).toFixed(2)}%, 0, 0)`;
+        under.style.opacity = `${(0.84 + 0.16 * progress).toFixed(3)}`;
+      }
+    };
+
+    const finish = (cancelled: boolean) => {
+      if (!active) return;
+      active = false;
+      if (!dragging) return;
+      dragging = false;
+
+      const dx = Math.max(0, lastX - startX);
+      const shouldCommit = !cancelled && (dx >= width * COMMIT_RATIO || (vx >= FLICK_VELOCITY && dx >= 32));
+      const top = topLayerRef.current;
+      const under = underLayerRef.current;
+      const ease = "160ms cubic-bezier(.22, 1, .36, 1)";
+
+      if (top) {
+        top.style.transition = `transform ${ease}`;
+        top.style.transform = shouldCommit ? `translate3d(${width}px, 0, 0)` : "translate3d(0, 0, 0)";
+      }
+      if (under) {
+        under.style.transition = `transform ${ease}, opacity ${ease}`;
+        under.style.transform = shouldCommit ? "translate3d(0, 0, 0)" : "translate3d(-22%, 0, 0)";
+        under.style.opacity = shouldCommit ? "1" : "0.84";
+      }
+
+      if (shouldCommit) haptic("light");
+      settleTimer = window.setTimeout(() => {
+        clearStyles(top, under);
+        stateRef.current.onPeekChange(false);
+        if (shouldCommit) stateRef.current.onSwipeCommit();
+      }, 165);
+    };
+
+    const onTouchEnd = () => finish(false);
+    const onTouchCancel = () => finish(true);
+
+    container.addEventListener("touchstart", onTouchStart, { passive: true });
+    container.addEventListener("touchmove", onTouchMove, { passive: false });
+    container.addEventListener("touchend", onTouchEnd, { passive: true });
+    container.addEventListener("touchcancel", onTouchCancel, { passive: true });
+
+    return () => {
+      window.clearTimeout(settleTimer);
+      container.removeEventListener("touchstart", onTouchStart);
+      container.removeEventListener("touchmove", onTouchMove);
+      container.removeEventListener("touchend", onTouchEnd);
+      container.removeEventListener("touchcancel", onTouchCancel);
+      clearStyles(topLayerRef.current, underLayerRef.current);
+    };
+  }, [containerRef, topLayerRef, underLayerRef]);
+}
